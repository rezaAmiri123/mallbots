customers:
ghz -c 50 -n 1000  --insecure --proto customers/customerspb/customer_api.proto --call customerspb.CustomersService.RegisterCustomer -d '{"name":"name", "sms_number":"sms_number"}' 0000:8000
ghz -c 100 -n 1000  --insecure --proto customerspb/customer_api.proto --call customerspb.CustomersService.GetCustomer -d '{"id":"76b54ef0-5737-4062-9748-d53b81400ace"}' 0000:8000


stores:
ghz -c 100 -n 1000  --insecure --proto stores/storespb/store_api.proto --call storespb.StoresService.CreateStore -d '{"name":"name", "location":"location"}' 0000:8000
ghz -c 100 -n 1000  --insecure --proto stores/storespb/store_api.proto --call storespb.StoresService.GetStore -d '{"id":"65ec1614-e328-43f6-8424-23f2330cf655"}' 0000:8000
ghz -c 100 -n 1000  --insecure --proto stores/storespb/store_api.proto --call storespb.StoresService.IncreaseProductPrice -d '{"id":"1f2a79f0-9f5e-4288-aedb-93d3c73f1ff7", "price": 1}' 0000:8000
